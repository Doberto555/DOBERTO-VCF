{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/auth/google/url", "destination": "/api/google-login-url" },
    { "source": "/api/auth/google/callback", "destination": "/api/google-callback" },
    { "source": "/api/register", "destination": "/api/register-secure" },
    { "source": "/api/admin/login", "destination": "/api/admin-login-secure" },
    { "source": "/api/settings/public", "destination": "/api/public-settings" },
    { "source": "/api/community/announce", "destination": "/api/community-announce" },
    { "source": "/api/admin/community/settings", "destination": "/api/admin-community-settings" },

    { "source": "/api/google/status", "destination": "/api/feature-removed" },
    { "source": "/api/google/sync", "destination": "/api/feature-removed" },
    { "source": "/api/google/auto-sync", "destination": "/api/feature-removed" },
    { "source": "/api/cron/google-sync", "destination": "/api/feature-removed" },
    { "source": "/api/vcf-bot-notify", "destination": "/api/feature-removed" },

    { "source": "/api/vip/status", "destination": "/api/feature-removed" },
    { "source": "/api/vip/catalog", "destination": "/api/feature-removed" },
    { "source": "/api/vip/methods", "destination": "/api/feature-removed" },
    { "source": "/api/vip/payment/request", "destination": "/api/feature-removed" },
    { "source": "/api/vip/moncash/create", "destination": "/api/feature-removed" },
    { "source": "/api/vip/moncash/verify", "destination": "/api/feature-removed" },
    { "source": "/api/vip/moncash/return", "destination": "/api/feature-removed" },
    { "source": "/api/vip/moncash/health", "destination": "/api/feature-removed" },
    { "source": "/api/admin/vip/methods", "destination": "/api/feature-removed" },
    { "source": "/api/admin/vip/payments", "destination": "/api/feature-removed" },
    { "source": "/api/admin/vip/members", "destination": "/api/feature-removed" },
    { "source": "/api/admin/vip/member/action", "destination": "/api/feature-removed" },

    { "source": "/api/vip-status", "destination": "/api/feature-removed" },
    { "source": "/api/vip-catalog", "destination": "/api/feature-removed" },
    { "source": "/api/vip-methods", "destination": "/api/feature-removed" },
    { "source": "/api/vip-payment-request", "destination": "/api/feature-removed" },
    { "source": "/api/vip-moncash-create", "destination": "/api/feature-removed" },
    { "source": "/api/vip-moncash-verify", "destination": "/api/feature-removed" },
    { "source": "/api/vip-moncash-return", "destination": "/api/feature-removed" },
    { "source": "/api/vip-moncash-health", "destination": "/api/feature-removed" },
    { "source": "/api/admin-vip-methods", "destination": "/api/feature-removed" },
    { "source": "/api/admin-vip-payments", "destination": "/api/feature-removed" },
    { "source": "/api/admin-vip-members", "destination": "/api/feature-removed" },
    { "source": "/api/admin-vip-member-action", "destination": "/api/feature-removed" },
    { "source": "/api/admin-vip-overview", "destination": "/api/feature-removed" },

    { "source": "/api/admin/system/health", "destination": "/api/admin-system-health" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.onesignal.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' https://onesignal.com https://*.onesignal.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/admin.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/owner-access.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/push/onesignal/OneSignalSDKWorker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }, { "key": "Service-Worker-Allowed", "value": "/push/onesignal/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }, { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }] }
  ]
}
