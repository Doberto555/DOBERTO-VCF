# DOBERTO VCF — example environment variables only.
# NEVER commit real secrets to GitHub.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
MIN_TO_UNLOCK=500
MAX_IN_FILE=50000
NAME_PREFIX=D.M.L
PORT=3000

# ---- Site ----
SITE_URL=https://doberto-vcf-509.vercel.app

# ---- Email notification when VCF unlocks ----
# Recommended: install Resend from Vercel Marketplace, then verify a sender domain.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM=DOBERTO VCF <notifications@yourdomain.com>

# ---- Optional OneSignal ----
ONESIGNAL_APP_ID=REPLACE_WITH_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=REPLACE_WITH_ONESIGNAL_REST_API_KEY
