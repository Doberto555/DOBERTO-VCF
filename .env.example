# DOBERTO VCF — production environment variables
# PA JANM mete vrè secret sa yo sou GitHub.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Minimòm 32 karaktè. Jenere yon secret random long.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

MIN_TO_UNLOCK=500
MAX_IN_FILE=50000
NAME_PREFIX=D.M.L
PORT=3200
SITE_URL=https://dobertovcf.online

# Google OAuth Web Client — sèlman pou Sign-In / enskripsyon.
# Scope yo dwe rete: openid email profile
# Authorized redirect URI production:
# https://dobertovcf.online/register.html
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://dobertovcf.online/register.html

# Email unlock via Resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM=DOBERTO VCF <notifications@dobertovcf.online>

# Sync Google Contacts via Shizzy Connect Partner API (sèvè-sèlman, PA JANM nan navigatè a)
# Yon kle API = yon patnè. Pa mete l sou GitHub.
SHIZZY_PARTNER_KEY=REPLACE_WITH_SHIZZY_PARTNER_API_KEY
SHIZZY_BASE_URL=https://shizzy-connect.online/api/v1/partner
# Kantite kontak maksimòm voye nan yon sèl sync (default 5000)
SHIZZY_BATCH_SIZE=5000

# Real Web Push via OneSignal
# App ID ka piblik; REST API Key la dwe rete server-side sèlman.
ONESIGNAL_APP_ID=REPLACE_WITH_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=REPLACE_WITH_ONESIGNAL_REST_API_KEY
